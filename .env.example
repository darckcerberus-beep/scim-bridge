# Environment variables for scim-bridge
# Copy this file to .env and fill in your values.

# -------------------------------------------------------
# SCIM bridge server settings
# -------------------------------------------------------

# Port the SCIM bridge listens on (default: 3000)
PORT=3000

# A static bearer token that your identity provider (IdP)
# sends in the Authorization header when calling the bridge.
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SCIM_BEARER_TOKEN=change-me-to-a-strong-secret

# -------------------------------------------------------
# Target API settings  (the system that has no SCIM support)
# -------------------------------------------------------

# Base URL of the target system's REST API
TARGET_API_BASE_URL=https://your-app.example.com/api

# Credentials the bridge uses to authenticate against the target API.
# Adjust TARGET_AUTH_TYPE to one of: bearer | basic | apikey
TARGET_AUTH_TYPE=bearer
TARGET_AUTH_TOKEN=your-target-api-token

# For basic auth, set:
# TARGET_AUTH_TYPE=basic
# TARGET_AUTH_USERNAME=admin
# TARGET_AUTH_PASSWORD=secret

# For a header-based API key, set:
# TARGET_AUTH_TYPE=apikey
# TARGET_AUTH_HEADER=X-Api-Key
# TARGET_AUTH_KEY=your-api-key

# -------------------------------------------------------
# Target API endpoint mapping
# Override these paths to match the target system's actual API.
# Use {id} as a placeholder for the user identifier.
# -------------------------------------------------------
TARGET_ENDPOINT_LIST_USERS=/users
TARGET_ENDPOINT_GET_USER=/users/{id}
TARGET_ENDPOINT_CREATE_USER=/users
TARGET_ENDPOINT_REPLACE_USER=/users/{id}
TARGET_ENDPOINT_UPDATE_USER=/users/{id}
TARGET_ENDPOINT_DELETE_USER=/users/{id}

# -------------------------------------------------------
# Debug logging (set to "true" to enable verbose output)
# -------------------------------------------------------
DEBUG=false
